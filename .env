# Turferz local development environment.
# The SQLite database file lives next to this config (prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Session signing secret. Replace with a long random string in production.
# If omitted, the app falls back to a development-only secret.
AUTH_SECRET="dev-secret-do-not-use-in-production-0f2c9a"
