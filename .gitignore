# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: local dev .env is committed (contains no real secrets).
# Keep anything that looks secret ignored.
.env.local
.env.*.local

# database files (created by `npm run setup`)
data/
*.db
*.db-shm
*.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
